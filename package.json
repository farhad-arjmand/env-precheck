{
  "name": "env-precheck",
  "version": "1.0.1",
  "description": "Validate .env files and CI environment variables against annotated .env.example contracts. Catch missing variables and invalid types without logging secret values.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "bin": {
    "env-precheck": "./bin/env-precheck.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "llms.txt",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/types.mts test/types.cts",
    "check": "npm test && npm run test:types",
    "test:package": "node scripts/smoke-pack.mjs",
    "prepack": "npm run build",
    "demo": "npm run build && node bin/env-precheck.mjs --contract examples/app.env.example --env examples/app.env.valid",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "dotenv",
    "env-validation",
    "environment-variables",
    "env-example",
    "configuration",
    "ci",
    "deployment",
    "secrets",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "author": "Farhad Arjmand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhad-arjmand/env-precheck.git"
  },
  "bugs": {
    "url": "https://github.com/farhad-arjmand/env-precheck/issues"
  },
  "homepage": "https://github.com/farhad-arjmand/env-precheck#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
